---
layout: base
title: Polarity Blindness in AI Safety (EACL 2027)

---

<div class="d-hero min-h-screen overflow-hidden relative bg-base-200 dark:bg-base-300">
  <div class="d-hero-content text-neutral-content text-center">
    <div class="max-w-4xl prose mt-10 relative">
      <a href="{{ paper.venue.url }}" target="_blank">
        <div class="d-btn mb-5 h-8 px-4 py-0 rounded-md text-md sm:text-lg font-medium prose prose-zinc-600 bg-base-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" width="97.241" height="88.687" viewBox="0 0 25.728 23.465">
            <path d="M105 134.784a2.66 2.66 0 0 0-1.477.44l-10.617 7.103c-.406.272-.54.768-.404 1.149.136.38.565.71 1.068.71h3.12v10H94.12a1.995 1.995 0 0 0-1.984 1.984v.094c0 1.088.896 1.984 1.984 1.984h21.758a1.995 1.995 0 0 0 1.984-1.984v-.094a1.995 1.995 0 0 0-1.984-1.985h-1.946v-10h2.496c.504 0 .933-.328 1.07-.71.135-.38.001-.876-.405-1.148l-10.617-7.103a2.66 2.66 0 0 0-1.477-.44m-5.311 9.401h1.748v10H99.69Zm4.748 0h1.748v10h-1.748zm4.748 0h1.748v10h-1.748z" style="fill:currentColor" transform="translate(-92.136 -134.783)"/>
          </svg>
          <span class="ms-1 mt-[0.3rem] mb-[0.2rem]">
            {{ paper.venue.name }}
          </span>
        </div>
        </button>
      </a>
      <h1 class="mb-2 mt-2 text-base-content text-4xl sm:text-5xl font-extrabold">{{ paper.title }}</h1>
      <h2 class="mb-8 mt-2 text-base-content text-2xl sm:text-3xl font-extrabold">{{ paper.subtitle }}</h2>
      <p class="flex flex-wrap justify-center mb-6 text-lg">
        {%- for author in paper.authors -%}
          <span class="whitespace-nowrap">
            <a href="{{ author.website }}">{{ author.name }}</a>
            <sup>{{ author.affiliations.split(",").join(", ") }}</sup>
            {%- if author.footnotes -%}
              <sup>
                {%- for footnote in author.footnotes.split(",") -%}
                  , {{ paper.footnotes[footnote]["symbol"] }}
                {%- endfor -%}
              </sup>
            {%- endif %}
            {%- if not loop.last -%}
              ,&nbsp;
            {%- endif -%}
          </span>
        {%- endfor -%}
      </p>
      <div class="mb-2">
        {%- for number, affiliation in paper.affiliations -%}
          <p class="mt-0 mb-0 text-sm"><sup>{{ number }}</sup> {{ affiliation }}</p>
        {%- endfor -%}
      </div>
      <div class="mb-12">
        {%- for _, footnote in paper.footnotes -%}
          <p class="mt-0 mb-0 text-sm">
            <sup>{{ footnote["symbol"] }}</sup> {{ footnote["text"] }}
          </p>
        {%- endfor -%}
      </div>
      <div class="flex align-bottom justify-center flex-wrap gap-x-10 gap-y-6">
        <a class="cursor-default no-underline" href="{{ paper.paper_url }}">
          <button class="d-btn d-btn-lg w-35 d-btn-primary rounded-full font-semibold">
            <svg
              class="size-[1.2em]"
              viewBox="0 0 24 24"
              stroke-width="1.7"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              color="currentColor"
            >
              <path
                d="M4 21.4V2.6C4 2.26863 4.26863 2 4.6 2H16.2515C16.4106 2 16.5632 2.06321 16.6757 2.17574L19.8243 5.32426C19.9368 5.43679 20 5.5894 20 5.74853V21.4C20 21.7314 19.7314 22 19.4 22H4.6C4.26863 22 4 21.7314 4 21.4Z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
              <path
                d="M8 10L16 10"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
              <path
                d="M8 18L16 18"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
              <path
                d="M8 14L12 14"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
              <path
                d="M16 2V5.4C16 5.73137 16.2686 6 16.6 6H20"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
            </svg>
            Paper
          </button>
        </a>
        <a href="{{ paper.code_url }}">
          <button class="d-btn d-btn-lg w-35 d-btn-primary rounded-full font-semibold">
            <svg
              class="size-[1.2em]"
              stroke-width="1.7"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              color="currentColor"
            >
              <path
                d="M16 22.0268V19.1568C16.0375 18.68 15.9731 18.2006 15.811 17.7506C15.6489 17.3006 15.3929 16.8902 15.06 16.5468C18.2 16.1968 21.5 15.0068 21.5 9.54679C21.4997 8.15062 20.9627 6.80799 20 5.79679C20.4558 4.5753 20.4236 3.22514 19.91 2.02679C19.91 2.02679 18.73 1.67679 16 3.50679C13.708 2.88561 11.292 2.88561 8.99999 3.50679C6.26999 1.67679 5.08999 2.02679 5.08999 2.02679C4.57636 3.22514 4.54413 4.5753 4.99999 5.79679C4.03011 6.81549 3.49251 8.17026 3.49999 9.57679C3.49999 14.9968 6.79998 16.1868 9.93998 16.5768C9.61098 16.9168 9.35725 17.3222 9.19529 17.7667C9.03334 18.2112 8.96679 18.6849 8.99999 19.1568V22.0268"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
              <path
                d="M9 20.0267C6 20.9999 3.5 20.0267 2 17.0267"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
            </svg>
            Code
          </button>
        </a>
        <a
          href="{{ paper.data_url }}"
        >
          <button class="d-btn d-btn-lg w-35 d-btn-primary rounded-full font-semibold">
            <svg
              class="size-[1.2em]"
              stroke-width="1.9"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              color="currentColor"
            >
              <path
                d="M3.6 3H20.4C20.7314 3 21 3.26863 21 3.6V20.4C21 20.7314 20.7314 21 20.4 21H3.6C3.26863 21 3 20.7314 3 20.4V3.6C3 3.26863 3.26863 3 3.6 3Z"
                stroke="currentColor"
                stroke-width="1.9"
              >
              </path>
              <path
                d="M9.75 9.75V21"
                stroke="currentColor"
                stroke-width="1.9"
              >
              </path>
              <path d="M3 9.75H21" stroke="currentColor" stroke-width="1.9">
              </path>
            </svg>
            Data
          </button>
        </a>
      </div>
        <img
          src="assets/img/robot-happy.svg"
          alt="Background"
          class="visible dark:invisible opacity-20 -rotate-25 absolute -top-10 inset-s-2 lg:-inset-s-8 scale-250 sm:scale-400 md:scale-420 -z-10"
        />
        <img
          src="assets/img/robot-confused.svg"
          alt="Background"
          class="visible dark:invisible opacity-20 rotate-25 absolute -top-10 inset-e-2 lg:-inset-e-8 scale-250 sm:scale-400 md:scale-420 -z-10"
        />
        <img
          src="assets/img/robot-happy-dark.svg"
          alt="Background"
          class="invisible dark:visible opacity-15 -rotate-25 absolute -top-10 inset-s-2 lg:-inset-s-8 scale-250 sm:scale-400 md:scale-420 -z-10"
        />
        <img
          src="assets/img/robot-confused-dark.svg"
          alt="Background"
          class="invisible dark:visible opacity-15 rotate-25 absolute -top-10 inset-e-2 lg:-inset-e-8 scale-250 sm:scale-400 md:scale-420 -z-10"
        />
    </div>
  </div>
</div>

<div class="section flex flex-col bg-base-100">
  <h1>Abstract</h1>
  {% renderTemplate "njk,md", paper %}
  {{ abstract }}
  {% endrenderTemplate %}
</div>

<div class="section flex flex-col overflow-hidden bg-base-200 dark:bg-base-300 items-center">
  <h1 class="self-start">Experimental Setup</h1>
  {% markdown %}
    {%- include "sections/experimental-setup.md" -%}
  {% endmarkdown %}
</div>

<div class="section flex flex-col overflow-hidden bg-base-100 items-center">
  <h1 class="self-start">Results</h1>
  {% markdown %}
    {%- include "sections/results.md" -%}
  {% endmarkdown %}
</div>

<div class="section flex flex-col overflow-hidden bg-base-200 dark:bg-base-300 items-center">
  <h1 class="self-start">Examples</h1>
  {% markdown %}
    {%- include "sections/examples.md" -%}
  {% endmarkdown %}
</div>

<div class="section bg-base-100">
  <h1>Citation</h1>
  <div class="d-card bg-base-200 py-2 px-6 md:py-6 md:px-8 w-full">
    <div class="absolute top-3 right-3">
      <div id="copy-tooltip" class="d-tooltip d-tooltip-left" data-tip="Copy">
        <button id="copy-citation" class="d-btn d-btn-square">
          <svg
            class="size-[1.2em] active"
            stroke-width="1.9"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            color="currentColor"
          >
            <path
              d="M19.4 20H9.6C9.26863 20 9 19.7314 9 19.4V9.6C9 9.26863 9.26863 9 9.6 9H19.4C19.7314 9 20 9.26863 20 9.6V19.4C20 19.7314 19.7314 20 19.4 20Z"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </path>
            <path
              d="M15 9V4.6C15 4.26863 14.7314 4 14.4 4H4.6C4.26863 4 4 4.26863 4 4.6V14.4C4 14.7314 4.26863 15 4.6 15H9"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </path>
          </svg>
          <svg
            class="size-[1.2em] text-success hidden"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            color="currentColor"
          >
            <path
              d="M8.5 4H6C4.89543 4 4 4.89543 4 6V20C4 21.1046 4.89543 22 6 22H12"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            >
            </path>
            <path
              d="M15.5 4H18C19.1046 4 20 4.89543 20 6V15"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            >
            </path>
            <path
              d="M8 6.4V4.5C8 4.22386 8.22386 4 8.5 4C8.77614 4 9.00422 3.77604 9.05152 3.50398C9.19968 2.65171 9.77399 1 12 1C14.226 1 14.8003 2.65171 14.9485 3.50398C14.9958 3.77604 15.2239 4 15.5 4C15.7761 4 16 4.22386 16 4.5V6.4C16 6.73137 15.7314 7 15.4 7H8.6C8.26863 7 8 6.73137 8 6.4Z"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            >
            </path>
            <path
              d="M15.5 20.5L17.5 22.5L22.5 17.5"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </path>
          </svg>
        </button>
      </div>
    </div>
    <p
      id="citation"
      class="font-mono text-sm overflow-scroll text-nowrap whitespace-pre"
    >
      {%- for cit in paper.citation -%}
        {%- if not loop.first and not loop.last -%}
          &nbsp;&nbsp;{{ cit }}{%- if loop.index0 < loop.length - 2-%},{%- endif -%}&#10;
        {%- elif loop.first -%}
          {{ cit }},&#10;
        {%- else -%}
          {{ cit }}
        {%- endif -%}
      {%- endfor -%}
    </p>
  </div>
</div>

<script src="scripts/copyToClipboard.js"></script>
<script src="scripts/carousel.js"></script>
